# RAG / FDE 部署环境变量模板
# 复制为 .env 后填写；.env 不要提交到 Git。

# ---------- BFF ----------
BFF_HOST=127.0.0.1
BFF_PORT=8000
BFF_PUBLIC_BASE_URL=https://rag.example.internal
BFF_SECRET_KEY=change-me
BFF_LOG_LEVEL=INFO

# ---------- RAGFlow ----------
RAGFLOW_BASE_URL=http://127.0.0.1:9380
RAGFLOW_API_KEY=change-me
RAGFLOW_DEFAULT_DATASET_ID=
RAGFLOW_TIMEOUT_SECONDS=120

# ---------- LLM 网关 ----------
LLM_BASE_URL=http://llm-gateway.example.internal:8080
LLM_API_KEY=change-me
LLM_MODEL=your-model-name
LLM_PROTOCOL=anthropic
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=60
LLM_TOTAL_TIMEOUT=180

# ---------- PostgreSQL ----------
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DB=rag
PG_USER=rag
PG_PASSWORD=change-me

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
REDIS_DB=0

# ---------- MinIO ----------
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=rag-docs

# ---------- 限流 / 并发 ----------
ASK_GLOBAL_CONCURRENCY=30
ASK_PER_USER_CONCURRENCY=2
ASK_QUEUE_TIMEOUT_SECONDS=30
SSE_KEEPALIVE_SECONDS=15

# ---------- 观测 ----------
METRICS_ENABLED=1
LOG_FORMAT=json
TRACE_HEADER=X-Request-ID
